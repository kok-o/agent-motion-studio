{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-motion-studio.local/manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "seed",
    "video",
    "brand",
    "assets",
    "audio",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "fps"
      ],
      "properties": {
        "aspectRatio": {
          "enum": [
            "9:16",
            "16:9"
          ]
        },
        "fps": {
          "const": 30
        },
        "safeArea": {
          "type": "number",
          "minimum": 0.04,
          "maximum": 0.16
        },
        "style": {
          "enum": [
            "studio",
            "kinetic"
          ]
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "background",
        "foreground",
        "accent",
        "font"
      ],
      "properties": {
        "theme": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "background": {
          "$ref": "#/definitions/color"
        },
        "foreground": {
          "$ref": "#/definitions/color"
        },
        "accent": {
          "$ref": "#/definitions/color"
        },
        "font": {
          "const": "builtin-sans"
        }
      }
    },
    "assets": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "enum": [
              "image",
              "audio",
              "video"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narration",
        "music"
      ],
      "properties": {
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "enum": [
                "none",
                "file",
                "edge"
              ]
            },
            "gainDb": {
              "$ref": "#/definitions/gain"
            },
            "voice": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "rate": {
              "type": "string",
              "pattern": "^[+-][0-9]{1,3}%$"
            },
            "pitch": {
              "type": "string",
              "pattern": "^[+-][0-9]{1,3}Hz$"
            }
          }
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "enum": [
                "none",
                "file",
                "procedural"
              ]
            },
            "asset": {
              "$ref": "#/definitions/id"
            },
            "gainDb": {
              "$ref": "#/definitions/gain"
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/scene"
      }
    },
    "revision": {
      "$ref": "#/definitions/id"
    },
    "history": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "createdAt",
          "scenes",
          "video",
          "audio",
          "brand"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "createdAt": {
            "type": "string",
            "maxLength": 40
          },
          "scenes": {
            "$ref": "#/properties/scenes"
          },
          "video": {
            "$ref": "#/properties/video"
          },
          "audio": {
            "$ref": "#/properties/audio"
          },
          "brand": {
            "$ref": "#/properties/brand"
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "gain": {
      "type": "number",
      "minimum": -60,
      "maximum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "durationFrames"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "enum": [
            "kinetic_title",
            "product_zoom",
            "cta",
            "video"
          ]
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "text": {
          "$ref": "#/definitions/text"
        },
        "highlight": {
          "$ref": "#/definitions/text"
        },
        "label": {
          "$ref": "#/definitions/text"
        },
        "asset": {
          "$ref": "#/definitions/id"
        },
        "caption": {
          "$ref": "#/definitions/text"
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "focalPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "fontSize": {
          "type": "integer",
          "minimum": 48,
          "maximum": 160
        },
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset": {
              "$ref": "#/definitions/id"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            }
          },
          "minProperties": 1,
          "maxProperties": 1
        },
        "captions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startMs",
              "endMs",
              "text"
            ],
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0
              },
              "endMs": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "$ref": "#/definitions/text"
              }
            }
          }
        },
        "trimStartSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "kinetic_title"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "asset"
                  ]
                },
                {
                  "required": [
                    "label"
                  ]
                },
                {
                  "required": [
                    "caption"
                  ]
                },
                {
                  "required": [
                    "fit"
                  ]
                },
                {
                  "required": [
                    "focalPoint"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "product_zoom"
              }
            }
          },
          "then": {
            "required": [
              "asset",
              "caption"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "label"
                  ]
                },
                {
                  "required": [
                    "highlight"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cta"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "label"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "asset"
                  ]
                },
                {
                  "required": [
                    "caption"
                  ]
                },
                {
                  "required": [
                    "fit"
                  ]
                },
                {
                  "required": [
                    "focalPoint"
                  ]
                },
                {
                  "required": [
                    "highlight"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              }
            }
          },
          "then": {
            "required": [
              "asset"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "highlight"
                  ]
                },
                {
                  "required": [
                    "label"
                  ]
                },
                {
                  "required": [
                    "caption"
                  ]
                },
                {
                  "required": [
                    "fontSize"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "history"
              ]
            },
            {
              "required": [
                "revision"
              ]
            }
          ]
        },
        "properties": {
          "assets": {
            "additionalProperties": {
              "properties": {
                "type": {
                  "enum": [
                    "image",
                    "audio"
                  ]
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sha256"
                    ]
                  },
                  {
                    "required": [
                      "name"
                    ]
                  }
                ]
              }
            }
          },
          "scenes": {
            "items": {
              "properties": {
                "type": {
                  "enum": [
                    "kinetic_title",
                    "product_zoom",
                    "cta"
                  ]
                }
              },
              "not": {
                "required": [
                  "trimStartSeconds"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
