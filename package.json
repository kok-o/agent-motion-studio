{
  "name": "agent-motion-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental local video storyboard and MP4 editor for people and AI agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "agent-motion-studio": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/spec.js"
  },
  "files": [
    "dist/audio.js",
    "dist/browser.js",
    "dist/browser-contract.js",
    "dist/cache-publication.js",
    "dist/cli.js",
    "dist/composition.js",
    "dist/engine.js",
    "dist/errors.js",
    "dist/export-library.js",
    "dist/generation-provider.js",
    "dist/generation-store.js",
    "dist/generation.js",
    "dist/media.js",
    "dist/json-input.js",
    "dist/pipeline.js",
    "dist/preview.js",
    "dist/project.js",
    "dist/runtime.js",
    "dist/server.js",
    "dist/spec.js",
    "dist/types.js",
    "dist/renderer/entry.js",
    "dist/renderer/index.html",
    "dist/studio/index.html",
    "dist/studio/app.js",
    "dist/studio/i18n.js",
    "dist/studio/generation-ui.js",
    "dist/studio/style.css",
    "schemas",
    "assets/fonts",
    "examples/*/manifest.json",
    "examples/orbit-demo/project.json",
    "examples/orbit-demo/PROVENANCE.md",
    "examples/orbit-demo/LICENSE",
    "examples/orbit-demo/README_RU.md",
    "examples/orbit-demo/assets/*",
    "examples/coffee-ritual/project.json",
    "examples/coffee-ritual/assets/*",
    "examples/coffee-ritual/CREDITS.md",
    "examples/coffee-ritual/LICENSE.md",
    "examples/coffee-ritual/provenance.json",
    "examples/coffee-ritual/README.md",
    "examples/repo-promo/assets/*",
    "examples/product-ad/assets/*",
    "examples/feature-explainer/assets/*",
    "examples/kinetic-promo/assets/*",
    "skills",
    "scripts/install-agent-skill.mjs",
    "scripts/api-agent.mjs",
    "docs/AGENT_WORKFLOW_RU.md",
    "docs/AGENT_VALIDATION.md",
    "docs/STATUS.md",
    "docs/PLAN_V0.2_RU.md",
    "docs/USER_TRIAL_RU.md",
    "docs/GETTING_STARTED.md",
    "docs/MANIFEST.md",
    "docs/COMPOSITION.md",
    "docs/SCENES.md",
    "docs/AUDIO.md",
    "docs/edge-requirements.txt",
    "docs/STUDIO_RU.md",
    "docs/GENERATION_RU.md",
    "docs/GENERATION_PROVIDER_DECISION.md",
    "docs/providers/replicate-wan-2.2-i2v-fast.snapshot.json",
    "docs/media/coffee-contact.jpg",
    "docs/media/CREDITS.md",
    "docs/media/coffee-original.mp4",
    "docs/media/coffee-changed.mp4",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "SECURITY.md",
    "docs/COMPATIBILITY.md",
    "docs/RELEASING.md",
    "docs/releases/v0.1.0.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "doctor": "node dist/cli.js doctor --json",
    "studio": "node dist/cli.js studio examples/coffee-ritual/project.json",
    "studio:orbit": "node dist/cli.js studio examples/orbit-demo/project.json",
    "demo:sources": "node scripts/create-orbit-sources.mjs",
    "test:studio": "node --test tests/integration/studio.test.mjs",
    "verify:studio": "node scripts/verify-studio.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run build && npm test && npm run check:release",
    "test:integration": "node --test --test-concurrency=1 tests/integration/audio.test.mjs tests/integration/brief-visual.test.mjs tests/integration/browser-contract.test.mjs tests/integration/cache.test.mjs tests/integration/composition.test.mjs tests/integration/conflict.test.mjs tests/integration/doctor.test.mjs tests/integration/edit-contract.test.mjs tests/integration/edit-catalog.test.mjs tests/integration/generated-take.test.mjs tests/integration/generation-service.test.mjs tests/integration/generation-ui.test.mjs tests/integration/i18n.test.mjs tests/integration/kinetic.test.mjs tests/integration/preview.test.mjs tests/integration/renderer.test.mjs tests/integration/source-mutation.test.mjs tests/integration/studio-sync.test.mjs tests/integration/studio.test.mjs",
    "test:generation": "node --test --test-concurrency=1 tests/unit/generation*.test.mjs tests/unit/project-generation.test.mjs tests/integration/generated-take.test.mjs tests/integration/generation-service.test.mjs tests/integration/generation-ui.test.mjs tests/integration/source-mutation.test.mjs",
    "test:generation:live": "node scripts/generation-live.mjs",
    "test:edge": "node --test tests/integration/edge.test.mjs",
    "test:windows": "node --test tests/integration/windows-cancellation.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "verify:package": "node scripts/verify-release-package.mjs",
    "verify:v02": "node scripts/verify-v02-consumer.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "image-size": "2.0.4",
    "puppeteer-core": "25.12.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "5.2.6",
    "@fontsource/oswald": "5.3.0",
    "@types/node": "22.14.1",
    "esbuild": "0.25.2",
    "typescript": "5.8.3"
  }
}
